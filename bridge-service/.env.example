# Bridge Service Configuration
PORT=3001

# Firebase service account credentials are loaded from serviceAccountKey.json
# Download from Firebase Console > Project Settings > Service Accounts

# Configure each computer to handle exactly one station.
# station1 = Fırın, station2 = Izgara, station3 = Kasa, station4 = Burger.
# PRINTER_NAME must exactly match a local queue shown by `lpstat -p`.
# Leave both unset only for a legacy single-bridge setup.
BRIDGE_STATION=
PRINTER_NAME=
